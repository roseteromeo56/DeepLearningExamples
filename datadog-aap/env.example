# Unified service tagging (DD_SERVICE is required by run-with-aap.sh).
DD_SERVICE=model-api
DD_ENV=production
DD_VERSION=1.0.0

# Address of the Datadog Agent reachable from the application container/host.
DD_AGENT_HOST=datadog-agent
DD_TRACE_AGENT_PORT=8126

# App and API Protection.
DD_APPSEC_ENABLED=true
DD_API_SECURITY_ENABLED=true
DD_APPSEC_AUTO_USER_INSTRUMENTATION_MODE=safe

# Required for blocking decisions and other remotely managed protections.
DD_REMOTE_CONFIGURATION_ENABLED=true
